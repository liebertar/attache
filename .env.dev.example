# dev 서버(공유 기계)용. 복사해서 채우고 dev compose 로 띄웁니다:
#   cp .env.dev.example .env.dev
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --build
# 로컬과 달리 Ollama 함대가 없다고 봅니다 — 모델은 Nebius Token Factory(키만 넣으면 주소는 compose 가 채움),
# 사전 브리핑은 Tavily. 키가 비면 규칙만으로 돕니다(스택은 똑같이 뜸).
NEBIUS_API_KEY=
TAVILY_API_KEY=
# 한 판에 쓰는 Tavily 크레딧 한도(기본 20)
#TAVILY_BUDGET_PER_ROUND=20
# 모델 id 를 바꿀 때만(기본은 compose 의 nvidia/... 값)
#MODEL_NANO=nvidia/Nemotron-3_5-Lightning
#MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
#MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
TICK_SECONDS=0.2
