# Jetson (JetPack 6, CUDA 12.6) 위의 llama.cpp 서버.
# 개발 PC 에서는 이 이미지가 안 빌드됩니다. drone/docker-compose.edge.yml 로만 씁니다.
FROM nvcr.io/nvidia/l4t-jetpack:r36.4.0 AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
        git cmake build-essential libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/ggml-org/llama.cpp /src \
    && cmake -S /src -B /src/build -DGGML_CUDA=ON -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /src/build --target llama-server -j"$(nproc)"

FROM nvcr.io/nvidia/l4t-jetpack:r36.4.0
COPY --from=build /src/build/bin/llama-server /usr/local/bin/llama-server
ENV MODEL_PATH=/models/model.gguf NGL=99
EXPOSE 8080
CMD ["sh", "-c", "llama-server -m $MODEL_PATH -ngl $NGL --host 0.0.0.0 --port 8080"]
