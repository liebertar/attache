# Skybrush Live, built as a static bundle and served by nginx.
# The browser draws the 3D: A-Frame and three.js on the Mac's Metal WebGL.
FROM node:22-bookworm AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
ARG LIVE_REF=master
RUN git clone --depth 1 --branch "$LIVE_REF" https://github.com/skybrush-io/live.git .
RUN npm ci && npm run bundle

FROM nginx:alpine
COPY --from=build /src/build /usr/share/nginx/html
