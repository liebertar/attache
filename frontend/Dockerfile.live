# Skybrush Live 를 정적 번들로 빌드해서 nginx 로 냅니다.
# 3D 는 브라우저에서 그립니다. A-Frame + three.js 가 Mac 의 Metal WebGL 을 씁니다.
FROM node:22-bookworm AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
ARG LIVE_REF=master
RUN git clone --depth 1 --branch "$LIVE_REF" https://github.com/skybrush-io/live.git .
RUN npm ci && npm run bundle

FROM nginx:alpine
COPY --from=build /src/build /usr/share/nginx/html
