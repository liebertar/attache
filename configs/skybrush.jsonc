// Skybrush Server config. Six virtual drones over Jamsil.
//
//   SIM-00, SIM-01, SIM-02  → the fleet that goes through the runtime
//   SIM-03, SIM-04, SIM-05  → the fleet that drives the actuator directly
//
// Each fleet is coloured with UAV-SIGNAL when it takes off: green is the runtime side, red the
// direct side.
{
  "EXTENSIONS": {
    // Where the browser (Skybrush Live) connects
    "http_server": { "host": "" },

    // Where the sky-net runtime and the direct agents connect.
    // Newline-delimited JSON, so clients need no library.
    "tcp": {},

    // See the picture first, without PX4. Real aircraft swap in the mavlink extension.
    "virtual_uavs": {
      "enabled": true,
      "count": 6,
      "id_format": "SIM-{0:02}",
      // Order is lon, lat, AMSL (not lat, lon)
      "origin": [127.0830, 37.5105, 20],
      "orientation": 0,
      "takeoff_area": { "type": "grid", "spacing": 14 }
    }
  }
}
