// Skybrush Server 설정. 잠실 상공에 가상 드론 여섯 대.
//
//   SIM-00, SIM-01, SIM-02  → 런타임을 거치는 기단
//   SIM-03, SIM-04, SIM-05  → 조종장치를 직접 만지는 기단
//
// 색은 UAV-SIGNAL 로 각 기단이 뜰 때 칠합니다. 초록이 런타임 쪽, 빨강이 직접 쪽입니다.
{
  "EXTENSIONS": {
    // 브라우저(Skybrush Live)가 붙는 곳
    "http_server": { "host": "" },

    // sky-net 런타임과 직결 에이전트가 붙는 곳.
    // 줄바꿈 구분 JSON 이라 클라이언트에 라이브러리가 필요 없습니다.
    "tcp": {},

    // PX4 없이 먼저 그림부터 봅니다. 실기체는 mavlink 확장으로 갈아끼웁니다.
    "virtual_uavs": {
      "enabled": true,
      "count": 6,
      "id_format": "SIM-{0:02}",
      // lon, lat, AMSL 순서입니다 (위경도 순서가 아닙니다)
      "origin": [127.0830, 37.5105, 20],
      "orientation": 0,
      "takeoff_area": { "type": "grid", "spacing": 14 }
    }
  }
}
